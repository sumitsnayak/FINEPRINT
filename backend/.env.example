# LabelLens Environment Configuration Example

# FastAPI Secret Key
JWT_SECRET_KEY=labellens-super-secret-jwt-key-2026-hackathon

# Database (Default: local SQLite database, or set to your Supabase/PostgreSQL connection string)
DATABASE_URL=sqlite:///./labellens.db
# Example PostgreSQL / Supabase connection:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Google Gemini API Key (Optional - when set, live Gemini generates personalized ingredient insights)
# If left empty, LabelLens seamlessly runs the verified offline Food Safety & Nutrition Knowledge Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase (Optional live credentials)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local OCR Settings (Optional: path to tesseract.exe if installed on host)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

